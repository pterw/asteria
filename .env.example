# ── Asteria · environment ─────────────────────────────────────────────────────────────
# Copy to `.env` for local work:  cp .env.example .env
#
# Nothing here is required to *run* the app locally. With DATABASE_URL unset, Asteria
# starts an embedded Postgres (PGlite) in ASTERIA_DB_DIR and works offline, which is how
# the test suite and this repository's preview run.
#
# Production (Vercel) needs exactly two things: DATABASE_URL, and ASTERIA_SECRET.

# ── Database ──────────────────────────────────────────────────────────────────────────
# Managed Postgres connection string (Neon, Supabase, RDS, Aiven, …).
# Leave a *pooler* host here: serverless functions open short-lived connections, and the
# pooler multiplexes them onto a handful of real ones.
#
# A Neon hostname is detected automatically and switches the driver to
# `@neondatabase/serverless`, which tunnels Postgres over a WebSocket instead of a TCP socket.
# Nothing else changes: same queries, same transactions.
#   Neon (pooled):  postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/asteria?sslmode=require
#   Supabase:       postgresql://postgres.ref:pass@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Neon publishes a second, *direct* string for the same database (no `-pooler` in the
# hostname). Migrations prefer it when it is present: schema changes need no session state, but
# they should not queue behind application traffic either. Vercel's Neon integration sets this
# variable for you; if yours is named POSTGRES_URL_NON_POOLING, that is read too.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/asteria?sslmode=require

# Force a driver (normally inferred from DATABASE_URL): neon | postgres | pglite
# ASTERIA_DB=pglite

# Where the embedded database keeps its files when the pglite driver is active.
# ASTERIA_DB_DIR=.asteria/data

# Pool tuning. The defaults suit serverless — two connections per instance (Neon's own
# recommendation for serverless: 1–2, and let PgBouncer do the multiplexing), a short idle
# timeout, and `allowExitOnIdle` in production so a suspended instance releases what it holds.
# POSTGRES_POOL_MAX=2
# POSTGRES_IDLE_TIMEOUT_MS=10000
# POSTGRES_CONNECT_TIMEOUT_MS=8000
# Optional explicit TLS override: disable | require | verify-full
# POSTGRES_SSL=require

# Client-side deadline for a single query. `statement_timeout` would be a session-level SET,
# which is not ours to make on a pooled connection, so the driver gives up instead.
# POSTGRES_QUERY_TIMEOUT_MS=15000

# ── Secrets ───────────────────────────────────────────────────────────────────────────
# Server-side pepper for session tokens and recovery keys (HMAC). Any long random
# string; rotate deliberately — rotating it invalidates existing sessions and
# recovery keys, because only the HMAC of each is stored.
#   openssl rand -base64 48
# ASTERIA_SECRET=change-me-in-production

# ── Insights service (optional) ───────────────────────────────────────────────────────
# Python service in services/insights. When unreachable, Asteria silently falls back to
# the equivalent in-process TypeScript implementation, so this is an optimisation and
# not a dependency. `npm run insights:dev` starts it locally.
# ASTERIA_INSIGHTS_URL=http://127.0.0.1:8000
# ASTERIA_INSIGHTS_SECRET=change-me-too
# ASTERIA_INSIGHTS_TIMEOUT_MS=2500

# ── Deployment ────────────────────────────────────────────────────────────────────────
# Canonical origin, used for metadata, canonicals, OG images and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://asteria.example.com

# ── Tests ─────────────────────────────────────────────────────────────────────────────
# Run the integration suite against a real Postgres instead of the embedded one. CI uses
# this against a `postgres:17` service, which is the only place the production driver
# (`pg`, a pool, a real socket) is exercised. Point it at a throwaway database: the suite
# drops the schema between files. It is deliberately not `DATABASE_URL`.
# ASTERIA_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/asteria_test

# ── Debug ─────────────────────────────────────────────────────────────────────────────
# Log driver SQL (Asteria logs structured JSON by default at info level).
# ASTERIA_SQL_LOG=1
# ASTERIA_LOG_LEVEL=debug
# Docker-compose host port, when 5432 is taken by another project.
# POSTGRES_PORT=5433

# ── Legacy docker-compose database (still supported) ──────────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
