# Copy to .env. One DATABASE_URL, read by both the app (src/db/index.ts) and drizzle-kit
# (drizzle.config.ts via dotenv), so they can never point at different databases.
#
#   cp .env.example .env
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Host port for docker-compose.yml (default 5432). Set it when 5432 is already taken by
# another project, and match the port in DATABASE_URL above.
# POSTGRES_PORT=5433
