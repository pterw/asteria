node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Screenshots and test output from scripts/review.mjs and Playwright.
artifacts/

# Secrets. Keeping .env out of source control also keeps Tailwind from scanning it.
.env*
!.env.example
# Playwright output dirs (playwright.config.ts writes into artifacts/, these are belt-and-braces).
test-results/
playwright-report/

# graphify: local-only artifacts. The interpreter marker holds an absolute
# machine path (regenerated automatically when missing); the analysis sidecar is
# rewritten on every build. The graph itself (graph.json, GRAPH_REPORT.md,
# graph.html) IS committed.
graphify-out/.graphify_python
graphify-out/.graphify_analysis.json

# Also local state: the root marker holds an absolute machine path, and
# manifest.json plus cache/ are rebuild state rewritten by every rebuild —
# including the one the post-commit hook launches.
graphify-out/.graphify_root
graphify-out/manifest.json
graphify-out/cache/
