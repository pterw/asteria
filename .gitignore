node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Screenshots and test output from scripts/review.mjs and Playwright.
artifacts/

# Secrets. Keeping .env out of source control also keeps Tailwind from scanning it.
.env*
!.env.example
# Playwright output dirs (playwright.config.ts writes into artifacts/, these are belt-and-braces).
test-results/
playwright-report/

# graphify: local-only artifacts. The interpreter marker holds an absolute
# machine path (regenerated automatically when missing); the analysis sidecar is
# rewritten on every build. The graph itself (graph.json, GRAPH_REPORT.md,
# graph.html) IS committed.
graphify-out/.graphify_python
graphify-out/.graphify_analysis.json

# Also local state: the root marker holds an absolute machine path, and
# manifest.json plus cache/ are rebuild state rewritten by every rebuild —
# including the one the post-commit hook launches.
graphify-out/.graphify_root
graphify-out/manifest.json
graphify-out/cache/

# Vendored agent skill bundles. Third-party, reconstructible from skills-lock.json, and
# already excluded from the graph and memory indexes for the same reason. They are also
# large: 33 MB across .agents/ and .agent/skills/impeccable/ against a 1.6 MB working tree.
.agents/
.agent/skills/impeccable/

# graphify: the remaining local rebuild state, alongside what is already ignored above.
# The dated snapshot directories hold a duplicate graph.json and report per build, and the
# label sidecar is rewritten on every build like .graphify_analysis.json. Only graph.json,
# GRAPH_REPORT.md and graph.html are project artifacts and stay tracked.
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
graphify-out/20*/
# Temporary scratch scripts and local critique configs
scratch/
.impeccable/